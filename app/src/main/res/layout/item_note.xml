<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Pin Indicator - Subtle -->
        <View
            android:id="@+id/accentBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/primary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Selection Checkbox -->
            <CheckBox
                android:id="@+id/selectCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                android:buttonTint="@color/primary"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title with Pin Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/pinIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/titleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Judul Catatan"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:letterSpacing="0.01" />

                </LinearLayout>

                <!-- Content Preview - More subtle -->
                <TextView
                    android:id="@+id/contentTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Isi catatan..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="10"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <!-- Footer - Clean & Minimal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <!-- Category Badge - Subtle -->
                    <TextView
                        android:id="@+id/categoryTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pribadi"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary"
                        android:background="@drawable/category_badge_modern"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp" />

                    <!-- Timestamp - Very subtle -->
                    <TextView
                        android:id="@+id/timestampTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Jan 2025"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>